---
customization:
  extraKernelArgs:
    # Intel iGPU
    - i915.enable_guc=3
    # PCI Passthrough
    - intel_iommu=on
    - iommu=pt
  systemExtensions:
    officialExtensions:
      # Intel iGPU
      - siderolabs/i915
      - siderolabs/intel-ucode
      # NFS Performance
      - siderolabs/nfsrahead
      # QEMU Guest Agent for Proxmox
      - siderolabs/qemu-guest-agent
