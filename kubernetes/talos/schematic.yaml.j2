---
customization:
  extraKernelArgs:
    # Intel iGPU Passthrough
    - i915.enable_guc=3
    - intel_iommu=on
    - iommu=pt
    # Disable onboard I219 NIC's
    # - module_blacklist=e100e
    # Less security for more performance
    # Ok-ish for homelabs, DON'T use in production
    - -init_on_alloc
    - init_on_alloc=0
    - -init_on_free
    - init_on_free=0
    - -selinux
    - mitigations=off
    - talos.auditd.disabled=1
  systemExtensions:
    officialExtensions:
      # Intel iGPU
      - siderolabs/i915
      - siderolabs/intel-ucode
      - siderolabs/mei
      # NFS Performance
      - siderolabs/nfsrahead
      # Miroir DRBD9 Replication
      - siderolabs/drbd
