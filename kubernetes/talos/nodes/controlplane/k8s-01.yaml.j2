# k8s-01
# ------
# Model: Lenovo M920q (i5-8500T)
# NICs:
#   - e1000e: 98:fa:9b:07:a0:07
#   - ixgbe: a0:36:9f:41:12:30
#   - ixgbe: a0:36:9f:41:12:32
# Disks:
#   - nvme-Viper_VP4000M_500GB
#   - nvme-KINGSTON_SNV3S1000G
---
# iGPU access for non-root workloads
machine:
  udev:
    rules:
      - 'SUBSYSTEM=="drm", KERNEL=="card*", GROUP="44", MODE="0660"'
      - 'SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"'
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-01
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "ixgbe" && mac(link.permanent_addr).startsWith("a0:36:9f:41:12:30")
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
bondMode: active-backup
mtu: 1500
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "KINGSTON SNV3S1000G"
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 128GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: system_disk
  grow: true
  minSize: 20GiB

