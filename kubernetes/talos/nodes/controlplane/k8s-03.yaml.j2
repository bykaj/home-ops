# k8s-03
# ------
# Model: Lenovo M90q Gen 5 (i5-13400T, 64GB)
# NICs:
#   - eno1:     c4:c6:e6:52:cf:b0 (e1000e)
#   - enp1s0f0: 90:e2:ba:c9:c5:70 (ixgbe)
#   - enp1s0f1: 90:e2:ba:c9:c5:71 (ixgbe)
# Disks:
#   - nvme0n1:  /dev/disk/by-id/nvme-KINGSTON_SNV3S1000G
#   - nvme1n1:  /dev/disk/by-id/nvme-Micron_7300_MTFDHBA480TDF
---
# iGPU access for non-root workloads
machine:
  udev:
    rules:
      - 'SUBSYSTEM=="drm", KERNEL=="card*", GROUP="44", MODE="0660"'
      - 'SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"'
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-03
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "ixgbe" && mac(link.permanent_addr).startsWith("90:e2:ba:c9:c5:70")
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
bondMode: active-backup
mtu: 1500
---
# Default 512-slot RX ring overflows on traffic bursts (rx_missed_errors)
apiVersion: v1alpha1
kind: EthernetConfig
name: enp1s0f0
rings:
  rx: 4096
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "KINGSTON SNV3S1000G"
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 160GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: system_disk
  grow: true
  minSize: 20GiB
