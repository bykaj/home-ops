# k8s-02
# ------
# Model: Lenovo M920x (i9-9900T, 64GB)
# NICs:
#   - eno1:     98:fa:9b:47:a4:90 (e1000e)
#   - enp1s0f0: b4:96:91:0d:7b:98 (ixgbe)
#   - enp1s0f1: b4:96:91:0d:7b:9a (ixgbe)
# Disks:
#   - nvme0n1:  /dev/disk/by-id/nvme-Micron_2450
#   - nvme1n1:  /dev/disk/by-id/nvme-KINGSTON_SNV3S1000G
---
# iGPU access for non-root workloads
machine:
  udev:
    rules:
      - 'SUBSYSTEM=="drm", KERNEL=="card*", GROUP="44", MODE="0660"'
      - 'SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"'
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: k8s-02
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node.kubernetes.io/gpu: "true"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "ixgbe" && mac(link.permanent_addr).startsWith("b4:96:91:0d:7b:98")
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
bondMode: active-backup
mtu: 1500
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: disk.model == "KINGSTON SNV3S1000G"
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 160GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: system_disk
  grow: true
  minSize: 20GiB

