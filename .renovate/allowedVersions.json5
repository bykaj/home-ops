{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["/postgresql/"],
      allowedVersions: "<19"
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["/postgres-init/"],
      allowedVersions: "<19"
    },
    {
      description: "Hold Rook-Ceph at v1.19.x",
      matchPackageNames: [
        "/rook-ceph/",
        "/rook-ceph-cluster/",
        "/rook\/ceph/"
      ],
      allowedVersions: "<1.20.0",
    },
  ]
}
